<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== Palette ===================== -->
    <Color x:Key="Bg0Color">#07081A</Color>
    <Color x:Key="Bg1Color">#0C0E26</Color>
    <Color x:Key="Bg2Color">#121540</Color>
    <Color x:Key="CardColor">#161A45</Color>
    <Color x:Key="Card2Color">#1D2257</Color>
    <Color x:Key="StrokeColor">#2B3175</Color>
    <Color x:Key="TextColor">#F5F6FF</Color>
    <Color x:Key="TextDimColor">#AEB4E8</Color>
    <Color x:Key="TextMutedColor">#6E75B5</Color>
    <Color x:Key="AccentColor">#2CE6FF</Color>
    <Color x:Key="YellowColor">#FFD23F</Color>
    <Color x:Key="PurpleColor">#8B5CFF</Color>
    <Color x:Key="PinkColor">#E040FB</Color>
    <Color x:Key="GreenColor">#3DDC84</Color>
    <Color x:Key="RedColor">#FF4D6D</Color>
    <Color x:Key="OrangeColor">#FF9A2E</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="Card2" Color="{StaticResource Card2Color}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoft" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Pressed" Color="#24FFFFFF" />

    <!-- Rarity -->
    <SolidColorBrush x:Key="RarityCommon" Color="#9AA4B4" />
    <SolidColorBrush x:Key="RarityUncommon" Color="#5FC234" />
    <SolidColorBrush x:Key="RarityRare" Color="#2E9BFF" />
    <SolidColorBrush x:Key="RarityEpic" Color="#B44CFF" />
    <SolidColorBrush x:Key="RarityLegendary" Color="#FF9A2E" />
    <SolidColorBrush x:Key="RarityMythic" Color="#FFD23F" />

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#1B2052" Offset="0" />
        <GradientStop Color="#13173F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="0.35" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="YellowButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF07A" Offset="0" />
        <GradientStop Color="#FFD23F" Offset="0.5" />
        <GradientStop Color="#F5B800" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2CE6FF" Offset="0" />
        <GradientStop Color="#8B5CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF3A6" Offset="0" />
        <GradientStop Color="#FFD23F" Offset="0.45" />
        <GradientStop Color="#FF9A2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StormGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B07CFF" Offset="0" />
        <GradientStop Color="#E040FB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E00A0C24" Offset="0" />
        <GradientStop Color="#E0080A1E" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Anton</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <SkewTransform x:Key="FortniteSkew" AngleX="-7" />

    <!-- ===================== Text styles ===================== -->
    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform" Value="{StaticResource FortniteSkew}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="30" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Caps" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="44" />
    </Style>

    <!-- Card container -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="#26000000" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <sys:Double x:Key="IconSize">20</sys:Double>
</ResourceDictionary>
