<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:FortniteHelper.Views.Pages"
                    xmlns:s="clr-namespace:FortniteHelper.Services"
                    xmlns:c="clr-namespace:FortniteHelper.Views.Controls">

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Placement badge -->
    <DataTemplate x:Key="PlacementBadge" DataType="{x:Type p:MatchRow}">
        <Grid Width="54" Height="54">
            <Border x:Name="Bd" CornerRadius="14" Background="#1AFFFFFF" BorderBrush="{Binding PlacementBrush}" BorderThickness="1.5" />
            <TextBlock x:Name="Txt" Text="{Binding Placement}" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{Binding PlacementBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="Crown" Source="{StaticResource ArtCrown}" Width="34" Visibility="Collapsed" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Victory}" Value="True">
                <Setter TargetName="Txt" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Crown" Property="Visibility" Value="Visible" />
                <Setter TargetName="Bd" Property="Background">
                    <Setter.Value>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FFD23F" Offset="0" />
                            <GradientStop Color="#14FFD23F" Offset="1" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One match in a list -->
    <DataTemplate x:Key="MatchRowTemplate" DataType="{x:Type p:MatchRow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PlacementBadge}" />
            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Result}" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource Text}" />
                    <Border Margin="8,0,0,0" CornerRadius="5" Padding="6,1" Background="#262CE6FF" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Mode}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextMuted}">
                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Duration, Mode=OneWay}" /><Run Text="{Binding Landed, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Kills}" Style="{StaticResource StatValue}" />
                <TextBlock Text="ELIMS" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Damage}" Style="{StaticResource StatValue}" />
                <TextBlock Text="DAMAGE" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Chests}" Style="{StaticResource StatValue}" Foreground="{StaticResource Yellow}" />
                    <c:Icon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="{StaticResource Green}" Margin="3,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Exact, Converter={StaticResource Vis}}" ToolTip="Exact - read from the replay" />
                </StackPanel>
                <TextBlock Text="CHESTS" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Accuracy}" Style="{StaticResource StatValue}" />
                <TextBlock Text="ACCURACY" Style="{StaticResource StatLabel}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Big stat tile -->
    <DataTemplate x:Key="StatTileTemplate" DataType="{x:Type p:StatTile}">
        <Border Style="{StaticResource InsetBorder}" Margin="0,0,10,10" Padding="16,12" MinWidth="130">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Caps}" />
                <TextBlock Text="{Binding Value}" Style="{StaticResource H2}" FontSize="26" Margin="0,4,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11.5" Visibility="{Binding Sub, Converter={StaticResource NullVis}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Coaching tip -->
    <DataTemplate x:Key="TipTemplate" DataType="{x:Type s:Tip}">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Dot" Width="28" Height="28" CornerRadius="9" Background="#262CE6FF" VerticalAlignment="Top">
                <c:Icon x:Name="Ic" Data="{StaticResource IconInfo}" Width="15" Height="15" Foreground="{StaticResource Accent}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Good">
                <Setter TargetName="Dot" Property="Background" Value="#2A5BE37D" />
                <Setter TargetName="Ic" Property="Data" Value="{StaticResource IconCheck}" />
                <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Improve">
                <Setter TargetName="Dot" Property="Background" Value="#2AFFD23F" />
                <Setter TargetName="Ic" Property="Data" Value="{StaticResource IconTarget}" />
                <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource Yellow}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Section title inside a card -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="34,6,30,30" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Spinner -->
    <Style x:Key="Spinner" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="44" Height="44">
                        <Ellipse Stroke="#22FFFFFF" StrokeThickness="4" />
                        <Path Data="M22,2 A20,20 0 0 1 42,22" Stroke="{StaticResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
