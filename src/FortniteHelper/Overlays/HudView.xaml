<UserControl x:Class="FortniteHelper.Overlays.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FortniteHelper.Views.Controls"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:EnumToVisibility x:Key="EnumVis" />
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1.5" Opacity="0.85" Color="Black" />

        <Style x:Key="HudCaps" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#C8CCF4" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#C8161A45" Offset="0" />
                        <GradientStop Color="#B00A0C24" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.Theme}" Value="Solid">
                    <Setter Property="Background" Value="#0C0E26" />
                    <Setter Property="BorderBrush" Value="#55FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Settings.Theme}" Value="Clear">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Opacity="{Binding Settings.Opacity}">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.Scale}" ScaleY="{Binding Settings.Scale}" />
        </Grid.LayoutTransform>

        <!-- ======================= CARD ======================= -->
        <Border Style="{StaticResource HudPanel}" Padding="14,12" MinWidth="200"
                Visibility="{Binding Settings.Layout, Converter={StaticResource EnumVis}, ConverterParameter=Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="58" Height="52">
                        <Ellipse x:Name="GlowCard" Margin="-10" Opacity="0.35" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#C0FFD23F" Offset="0" />
                                    <GradientStop Color="#00FFD23F" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image x:Name="ChestCard" Source="{StaticResource ArtChest}" RenderTransformOrigin="0.5,0.7">
                            <Image.RenderTransform>
                                <ScaleTransform />
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock x:Name="PlusCard" Text="+1" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{Binding AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-14,0" Opacity="0" Effect="{StaticResource TextShadow}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <c:AnimatedNumber Value="{Binding MatchChests}" FontFamily="{StaticResource DisplayFont}" FontSize="36" Foreground="{Binding AccentBrush}"
                                              Effect="{StaticResource TextShadow}" Margin="0,-6,0,-4" />
                            <c:Icon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="#5BE37D" Margin="7,4,0,0" VerticalAlignment="Center"
                                    ToolTip="Exact count from the replay" Visibility="{Binding Exact, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MatchLabel}" Style="{StaticResource HudCaps}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#26FFFFFF" Margin="0,10,0,8" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0" Visibility="{Binding Settings.ShowToday, Converter={StaticResource Vis}}">
                        <c:AnimatedNumber Value="{Binding TodayChests}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="TODAY" Style="{StaticResource HudCaps}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" Visibility="{Binding Settings.ShowAllTime, Converter={StaticResource Vis}}">
                        <c:AnimatedNumber Value="{Binding AllTimeChests}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="ALL TIME" Style="{StaticResource HudCaps}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" Visibility="{Binding CpmVisible, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Cpm}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="CPM" Style="{StaticResource HudCaps}" ToolTip="Chests per match" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding PirateVisible, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Pirate}" Style="{StaticResource HudValue}" Foreground="#FFD23F" />
                        <TextBlock Text="PIRATE" Style="{StaticResource HudCaps}" ToolTip="Chance you've found the Pirate token" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= COMPACT ======================= -->
        <Border Style="{StaticResource HudPanel}" CornerRadius="24" Padding="10,6,16,6"
                Visibility="{Binding Settings.Layout, Converter={StaticResource EnumVis}, ConverterParameter=Compact}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="36">
                    <Ellipse x:Name="GlowCompact" Margin="-8" Opacity="0.3" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#C0FFD23F" Offset="0" />
                                <GradientStop Color="#00FFD23F" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image x:Name="ChestCompact" Source="{StaticResource ArtChest}" RenderTransformOrigin="0.5,0.7">
                        <Image.RenderTransform>
                            <ScaleTransform />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <c:AnimatedNumber Value="{Binding MatchChests}" FontFamily="{StaticResource DisplayFont}" FontSize="28" Foreground="{Binding AccentBrush}"
                                  VerticalAlignment="Center" Margin="10,0,4,0" Effect="{StaticResource TextShadow}" />
                <c:Icon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="#5BE37D" VerticalAlignment="Center" Margin="0,0,4,0"
                        Visibility="{Binding Exact, Converter={StaticResource Vis}}" />
                <Border Width="1" Background="#33FFFFFF" Margin="8,4,0,4" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Settings.ShowToday, Converter={StaticResource Vis}}">
                    <c:AnimatedNumber Value="{Binding TodayChests}" Style="{StaticResource HudValue}" FontSize="15" />
                    <TextBlock Text="TODAY" Style="{StaticResource HudCaps}" FontSize="9" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Settings.ShowAllTime, Converter={StaticResource Vis}}">
                    <c:AnimatedNumber Value="{Binding AllTimeChests}" Style="{StaticResource HudValue}" FontSize="15" />
                    <TextBlock Text="ALL TIME" Style="{StaticResource HudCaps}" FontSize="9" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding CpmVisible, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Cpm}" Style="{StaticResource HudValue}" FontSize="15" />
                    <TextBlock Text="CPM" Style="{StaticResource HudCaps}" FontSize="9" />
                </StackPanel>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding PirateVisible, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Pirate}" Style="{StaticResource HudValue}" FontSize="15" Foreground="#FFD23F" />
                    <TextBlock Text="PIRATE" Style="{StaticResource HudCaps}" FontSize="9" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= MINIMAL ======================= -->
        <StackPanel Orientation="Horizontal" Visibility="{Binding Settings.Layout, Converter={StaticResource EnumVis}, ConverterParameter=Minimal}">
            <Image x:Name="ChestMinimal" Source="{StaticResource ArtChest}" Width="38" Height="34" RenderTransformOrigin="0.5,0.7">
                <Image.RenderTransform>
                    <ScaleTransform />
                </Image.RenderTransform>
            </Image>
            <c:AnimatedNumber Value="{Binding MatchChests}" FontFamily="{StaticResource DisplayFont}" FontSize="30" Foreground="{Binding AccentBrush}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Effect="{StaticResource TextShadow}" />
            <TextBlock Text="{Binding TodayChests, StringFormat=' / {0}'}" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="White"
                       VerticalAlignment="Center" Margin="4,6,0,0" Effect="{StaticResource TextShadow}"
                       Visibility="{Binding Settings.ShowToday, Converter={StaticResource Vis}}" />
        </StackPanel>

        <!-- Edit-mode frame -->
        <Border x:Name="EditFrame" Visibility="Collapsed" CornerRadius="16" BorderThickness="2" BorderBrush="#FFD23F" Margin="-6" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="#22FFD23F" />
            </Border.Background>
            <TextBlock Text="DRAG ME" FontFamily="{StaticResource DisplayFont}" Foreground="#FFD23F" FontSize="12" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,-20" Effect="{StaticResource TextShadow}" />
        </Border>
    </Grid>
</UserControl>
