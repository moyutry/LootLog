<Application x:Class="FortniteHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FortniteHelper.Views.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Art.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToVisibility x:Key="Vis" />
            <c:BoolToVisibility x:Key="InvVis" Invert="True" />
            <c:NullToVisibility x:Key="NullVis" />
            <c:EnumEquals x:Key="EnumEq" />
            <c:EnumToVisibility x:Key="EnumVis" />
            <c:Percent x:Key="Percent" />
            <c:HexToBrush x:Key="HexBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
