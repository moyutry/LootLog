<UserControl x:Class="FortniteHelper.Views.WelcomeWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:FortniteHelper.Overlays"
             xmlns:c="clr-namespace:FortniteHelper.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="BigBadge" TargetType="Border">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- One numbered instruction line -->
        <Style x:Key="HowTo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <Border Width="700" Height="600" CornerRadius="24" BorderThickness="1" BorderBrush="#40FFD23F" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E2470" Offset="0" />
                <GradientStop Color="#141840" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="8" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- soft glow behind the art -->
            <Ellipse Grid.RowSpan="3" Width="520" Height="420" VerticalAlignment="Top" Margin="0,-120,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33FFD23F" Offset="0" />
                        <GradientStop Color="#00FFD23F" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Top bar: step counter + skip -->
            <Grid Margin="28,22,22,0">
                <TextBlock x:Name="StepCounter" Style="{StaticResource Caps}" FontSize="11.5" VerticalAlignment="Center" />
                <Button x:Name="SkipBtn" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="12,6" Click="Skip_Click">
                    <TextBlock Text="Skip setup" Foreground="{StaticResource TextMuted}" FontSize="12.5" />
                </Button>
            </Grid>

            <!-- ===== Steps ===== -->
            <Grid x:Name="Steps" Grid.Row="1" Margin="40,0,40,0">

                <!-- 0: Hello -->
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{StaticResource ArtChest}" Width="150" Height="136" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource StepTitle}" Text="WELCOME TO LOOTLOG" FontSize="40" />
                    <TextBlock Style="{StaticResource StepText}" Text="It counts every chest you open in Fortnite - exactly. Setup takes 30 seconds." />
                    <StackPanel HorizontalAlignment="Center" Margin="0,26,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#26FFD23F"><c:Icon Data="{StaticResource IconChest}" Width="18" Height="18" Foreground="{StaticResource Yellow}" /></Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Text}" Text="Your exact chests after every match" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#262CE6FF"><c:Icon Data="{StaticResource IconStats}" Width="18" Height="18" Foreground="{StaticResource Accent}" /></Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Text}" Text="Chests per match - for you and your squad" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#26E040FB"><c:Icon Data="{StaticResource IconSparkle}" Width="18" Height="18" Foreground="{StaticResource Pink}" /></Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Text}" Text="Your real chance of the Pirate token" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 1: Chest key -->
                <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource BigBadge}" Background="#26FFD23F">
                        <c:Icon Data="{StaticResource IconKeyboard}" Width="48" Height="48" Foreground="{StaticResource Yellow}" />
                    </Border>
                    <TextBlock Style="{StaticResource StepTitle}" Text="WHICH KEY OPENS CHESTS?" />
                    <TextBlock Style="{StaticResource StepText}" Text="Click the box, then press the key you use to open chests in Fortnite. Most players use E." />
                    <c:KeyBindingBox x:Name="KeyBox" HorizontalAlignment="Center" Margin="0,28,0,0" BindingValue="{Binding Detection.InteractKey}">
                        <c:KeyBindingBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                        </c:KeyBindingBox.LayoutTransform>
                    </c:KeyBindingBox>
                    <TextBlock Style="{StaticResource StepText}" FontSize="12.5" Margin="0,22,0,0" Foreground="{StaticResource TextMuted}"
                               Text="LootLog only listens to this key. It never presses anything for you." />
                </StackPanel>

                <!-- 2: Replays -->
                <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
                    <Border x:Name="ReplayBadge" Style="{StaticResource BigBadge}">
                        <c:Icon x:Name="ReplayIcon" Width="48" Height="48" />
                    </Border>
                    <TextBlock x:Name="ReplayTitle" Style="{StaticResource StepTitle}" />
                    <TextBlock x:Name="ReplayText" Style="{StaticResource StepText}" />
                    <Border x:Name="ReplayHow" Style="{StaticResource InsetBorder}" Margin="0,20,0,0" Padding="20,14" HorizontalAlignment="Center" MinWidth="420">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="1." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> Open Fortnite and go to <Run Text="Settings" FontWeight="SemiBold" /> (the gear).</TextBlock>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="2." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> Open the <Run Text="Game" FontWeight="SemiBold" /> tab and scroll down to <Run Text="Replays" FontWeight="SemiBold" />.</TextBlock>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="3." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> Turn <Run Text="Record Replays" FontWeight="SemiBold" /> ON, then play a match.</TextBlock>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ReplayRecheck" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Recheck_Click">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconRefresh}" Width="15" Height="15" /><TextBlock Text="Check again" Margin="8,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- 3: Window mode -->
                <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
                    <Border x:Name="ModeBadge" Style="{StaticResource BigBadge}">
                        <c:Icon x:Name="ModeIcon" Width="48" Height="48" />
                    </Border>
                    <TextBlock x:Name="ModeTitle" Style="{StaticResource StepTitle}" />
                    <TextBlock x:Name="ModeText" Style="{StaticResource StepText}" />
                    <Border x:Name="ModeHow" Style="{StaticResource InsetBorder}" Margin="0,20,0,0" Padding="20,14" HorizontalAlignment="Center" MinWidth="420">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="1." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> In Fortnite open <Run Text="Settings" FontWeight="SemiBold" /> → <Run Text="Display" FontWeight="SemiBold" />.</TextBlock>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="2." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> Set <Run Text="Window Mode" FontWeight="SemiBold" /> to <Run Text="Windowed Fullscreen" FontWeight="SemiBold" />.</TextBlock>
                            <TextBlock Style="{StaticResource HowTo}"><Run Text="3." Foreground="{StaticResource Yellow}" FontWeight="Bold" /> Click <Run Text="Apply" FontWeight="SemiBold" />. It looks the same and runs just as fast.</TextBlock>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ModeRecheck" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Recheck_Click">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconRefresh}" Width="15" Height="15" /><TextBlock Text="Check again" Margin="8,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- 4: The box in the game -->
                <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource StepTitle}" Text="YOUR CHESTS, IN THE GAME" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource StepText}" Text="A small box on the side of your screen while you play." />
                    <Border CornerRadius="14" Height="170" ClipToBounds="True" Margin="0,18,0,16" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5A9CD8" Offset="0" />
                                <GradientStop Color="#8CC2EC" Offset="0.55" />
                                <GradientStop Color="#4E8A3A" Offset="0.56" />
                                <GradientStop Color="#3C6E2C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <o:HudView x:Name="Preview" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" />
                    </Border>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Hud.Enabled}">
                        <StackPanel>
                            <TextBlock Text="Show my chests in the game" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="You can move it anywhere later" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" x:Name="StreamSwitch" Checked="Stream_Changed" Unchecked="Stream_Changed">
                        <StackPanel>
                            <TextBlock Text="I stream or record - let viewers see the box" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Otherwise it's hidden from OBS, Discord and screenshots" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- 5: Done -->
                <StackPanel VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource BigBadge}" Width="120" Height="120" CornerRadius="60" Background="#2632D74B">
                        <c:Icon Data="{StaticResource IconCheck}" Width="62" Height="62" Foreground="{StaticResource Green}" />
                    </Border>
                    <TextBlock Style="{StaticResource StepTitle}" Text="YOU'RE ALL SET!" FontSize="42" />
                    <TextBlock Style="{StaticResource StepText}" Text="Just play. When you're back in the lobby, your exact chests show up here." />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding General.StartWithWindows}" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="Start LootLog with Windows (recommended)" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="So it's always ready when you play" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource StepText}" FontSize="12.5" Margin="0,14,0,0" Foreground="{StaticResource TextMuted}"
                               Text="LootLog keeps itself up to date. It never touches the game." />
                </StackPanel>
            </Grid>

            <!-- Bottom bar: back · dots · next -->
            <Grid Grid.Row="2" Margin="28,0,28,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackBtn" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Padding="16,10" Click="Back_Click">
                    <TextBlock Text="← Back" Foreground="{StaticResource TextDim}" FontSize="14" FontWeight="SemiBold" />
                </Button>
                <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="NextBtn" Grid.Column="2" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="26,11" Click="Next_Click">
                    <TextBlock x:Name="NextText" Text="NEXT" FontSize="16" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
