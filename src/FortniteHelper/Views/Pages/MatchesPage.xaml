<UserControl x:Class="FortniteHelper.Views.Pages.MatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:FortniteHelper.Views.Pages"
             xmlns:c="clr-namespace:FortniteHelper.Views.Controls">
    <UserControl.Resources>
        <!-- Compact row for the list -->
        <DataTemplate x:Key="MatchRowCompact" DataType="{x:Type p:MatchRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PlacementBadge}">
                    <ContentPresenter.LayoutTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </ContentPresenter.LayoutTransform>
                </ContentPresenter>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Result}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text="{Binding Landed, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Chests}" Style="{StaticResource StatValue}" Foreground="{StaticResource Yellow}" />
                        <c:Icon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="{StaticResource Green}" Margin="3,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Exact, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <TextBlock Text="CHESTS" Style="{StaticResource StatLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kills}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="ELIMS" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,6,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ My stats ============ -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="MY STATS" Style="{StaticResource H2}" FontSize="19" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Today" Tag="today" Checked="Filter_Changed" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days" Tag="7" Checked="Filter_Changed" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days" Tag="30" Checked="Filter_Changed" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="All" Tag="all" IsChecked="True" Checked="Filter_Changed" />
                        <ComboBox x:Name="ModeFilter" Width="190" Margin="12,0,0,0" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <WrapPanel x:Name="Summary" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button x:Name="ImportBtn" Click="Import_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                            <TextBlock x:Name="ImportText" Text="Scan for new matches" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Export_Click" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconExport}" Width="16" Height="16" />
                            <TextBlock Text="Export to CSV (Excel)" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ List ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <ListBox x:Name="List" ItemTemplate="{StaticResource MatchRowCompact}" SelectionChanged="List_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" />
                <TextBlock x:Name="Empty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No matches for this filter." Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ============ Report ============ -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <ScrollViewer x:Name="ReportScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Report" Margin="22,20,22,22">
                    <TextBlock Style="{StaticResource Muted}" Text="Select a match to see its full report." />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
