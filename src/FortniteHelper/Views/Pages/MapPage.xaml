<UserControl x:Class="FortniteHelper.Views.Pages.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FortniteHelper.Views.Controls">
    <Grid Margin="34,6,30,26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <c:MapView x:Name="Map" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" CornerRadius="10" Background="#D90C0E26" Padding="12,8">
                    <StackPanel>
                        <CheckBox x:Name="ShowChests" Style="{StaticResource Switch}" IsChecked="True" Click="Layer_Click" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#FFD23F" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="Chests" Margin="6,0,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ShowLandings" Style="{StaticResource Switch}" IsChecked="True" Click="Layer_Click" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#2CE6FF" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="My landings" Margin="6,0,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Background="#CC0C0E26" ToolTip="Reset view" Click="ResetView_Click">
                    <c:Icon Data="{StaticResource IconRefresh}" Width="17" Height="17" />
                </Button>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" CornerRadius="10" Background="#D90C0E26" Padding="12,7">
                    <TextBlock x:Name="MapHint" Style="{StaticResource Muted}" FontSize="12" Foreground="{StaticResource TextDim}"
                               Text="Scroll to zoom · drag to move · click a place for details" />
                </Border>
                <StackPanel x:Name="MapLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Spinner}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MapLoadingText" Text="Loading the island..." Style="{StaticResource Muted}" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,14,16">
                <StackPanel>
                    <!-- Selected place -->
                    <Border x:Name="PlaceCard" Style="{StaticResource InsetBorder}" Padding="16,14" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="PlaceName" Style="{StaticResource H2}" FontSize="22" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,30,0" />
                                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ClosePlace_Click" ToolTip="Close">
                                    <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="PlaceVerdict" Foreground="{StaticResource Yellow}" FontWeight="SemiBold" Margin="0,4,0,10" TextWrapping="Wrap" />
                            <UniformGrid x:Name="PlaceTiles" Columns="2" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BEST DROPS FOR CHESTS" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Where you open the most chests per match, from your own replays." />
                    <ItemsControl x:Name="BestList" />
                    <TextBlock x:Name="NoBest" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Land in a few different places - after each match the replay tells us how many chests you got there." />

                    <TextBlock Text="MOST CHESTS FOUND" Style="{StaticResource CardTitle}" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Places with the most chest spots on the map so far." />
                    <ItemsControl x:Name="DenseList" />

                    <Border Style="{StaticResource InsetBorder}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:Icon Data="{StaticResource IconInfo}" Width="18" Height="18" Foreground="{StaticResource Accent}" VerticalAlignment="Top" />
                            <TextBlock x:Name="AboutText" Grid.Column="1" Style="{StaticResource Body}" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
