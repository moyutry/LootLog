<Window x:Class="FortniteHelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FortniteHelper.Views.Controls"
        xmlns:v="clr-namespace:FortniteHelper.Views"
        Title="LootLog" Width="1320" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/AppIcon.ico" FontFamily="{StaticResource UiFont}" FontSize="13.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- ===== Background glow art ===== -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="1000" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-380,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D7A3CFF" Offset="0" />
                        <GradientStop Color="#007A3CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="1100" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-380,-420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#382CE6FF" Offset="0" />
                        <GradientStop Color="#002CE6FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="700" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-120,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2AE040FB" Offset="0" />
                        <GradientStop Color="#00E040FB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,18,16,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="46" Height="46">
                            <Ellipse Margin="-8" Opacity="0.6">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#AAFFD23F" Offset="0" />
                                        <GradientStop Color="#00FFD23F" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Image Source="pack://application:,,,/Assets/AppIcon.png" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LOOT" Style="{StaticResource Display}" FontSize="24" Margin="0,0,0,-8" />
                            <TextBlock Text="LOG" Style="{StaticResource Display}" FontSize="24" Foreground="{StaticResource Yellow}" />
                        </StackPanel>
                    </Grid>

                    <!-- Live status -->
                    <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" CornerRadius="14" Padding="14,12" Background="#1AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusPulse" Fill="{StaticResource Green}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="StatusDot" Fill="{StaticResource TextMuted}" />
                                </Grid>
                                <TextBlock x:Name="StatusText" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" FontSize="11.5" Margin="19,2,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{StaticResource ArtChest}" Width="30" Height="27" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <c:AnimatedNumber x:Name="SideChests" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource Yellow}" />
                                    <TextBlock x:Name="SideChestsLabel" Style="{StaticResource Caps}" FontSize="9.5" Text="CHESTS TODAY" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="Nav">
                        <RadioButton Style="{StaticResource NavItem}" Tag="home" IsChecked="True">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconHome}" /><TextBlock Text="Home" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="matches">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconHistory}" /><TextBlock Text="My Matches" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="map">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconMap}" /><TextBlock Text="Chest Map" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="crosshair">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconCrosshair}" /><TextBlock Text="Crosshair" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="settings">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconSettings}" /><TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Main area ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="34,0,10,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" FontSize="30" HorizontalAlignment="Left" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" Margin="2,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0">
                        <Button Style="{StaticResource CaptionBtn}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click" ToolTip="Minimize">
                            <c:Icon Data="{StaticResource IconMinimize}" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource CaptionBtn}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click" ToolTip="Maximize">
                            <c:Icon Data="{StaticResource IconMaximize}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource CaptionCloseBtn}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close to tray">
                            <c:Icon Data="{StaticResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>

        <!-- First-run setup, one step at a time -->
        <Grid x:Name="Welcome" Visibility="Collapsed" Background="#E0060818">
            <v:WelcomeWizard x:Name="Wizard" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastBox" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" CornerRadius="12" Padding="16,11"
                Background="#F0222866" BorderBrush="#552CE6FF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform Y="20" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource IconCheck}" Width="18" Height="18" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
